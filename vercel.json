{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/device-health",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/close-punches",
      "schedule": "30 22 * * *"
    }
  ]
}
